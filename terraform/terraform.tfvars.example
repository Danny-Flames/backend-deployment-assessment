###############################################################################
# Example variable values.
#
#   cp terraform.tfvars.example terraform.tfvars
#
# then edit terraform.tfvars with your real values. terraform.tfvars is listed
# in .gitignore and must never be committed. This example file contains no
# secrets and is safe to commit.
###############################################################################

# --- Region and naming -------------------------------------------------------
aws_region   = "us-east-1"
project_name = "startuptech"
environment  = "dev"

# --- Networking --------------------------------------------------------------
vpc_cidr             = "10.0.0.0/16"
public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs = ["10.0.11.0/24", "10.0.12.0/24"]

# --- Instance types ----------------------------------------------------------
bastion_instance_type = "t3.micro"
backend_instance_type = "t3.micro"
mongodb_instance_type = "t3.micro"

# --- Access ------------------------------------------------------------------
# Your current public IP, /32. Find it with:
#   curl -s https://checkip.amazonaws.com
# Replace the placeholder below - this value is only an example.
my_ip_cidr = "203.0.113.25/32"

# Contents of your SSH PUBLIC key (never the private one):
#   cat ~/.ssh/id_ed25519.pub
ssh_public_key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIEXAMPLEKEYREPLACEME you@example.com"

# --- Application -------------------------------------------------------------
backend_port      = 8080
health_check_path = "/health"

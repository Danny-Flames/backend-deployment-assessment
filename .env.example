# Copy to .env and fill in before running `docker compose up -d --build`.
#   cp .env.example .env
#
# .env is listed in .gitignore and must never be committed.

# Database name created inside MongoDB.
DB_NAME=much_todo_db

# Secret used to sign JWTs. Generate a fresh random value, do not reuse this:
#   openssl rand -base64 48
JWT_SECRET_KEY=replace-me-with-a-long-random-string

# How long an issued token stays valid.
JWT_EXPIRATION_HOURS=72

# Logging. LOG_LEVEL: DEBUG | INFO | WARN | ERROR.  LOG_FORMAT: json | text
LOG_LEVEL=INFO
LOG_FORMAT=json
